# ─────────────────────────────────────────
#  Dream Life Mapping — Environment Variables
#  Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────

# Kit (ConvertKit) — your form ID for email capture
# Find this in Kit → Forms → select form → grab the ID from the URL
NEXT_PUBLIC_KIT_FORM_ID=

# Checkout URL — where CTA buttons send people to buy
# This could be a Circle checkout link, Stripe payment link, or ThriveCart URL
NEXT_PUBLIC_CHECKOUT_URL=

# Payment plan checkout URL (if different from full-pay)
NEXT_PUBLIC_CHECKOUT_URL_PLAN=

# Meta Pixel ID (optional — for Facebook/Instagram ad tracking)
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics Measurement ID (optional)
NEXT_PUBLIC_GA_ID=

# Kit API Secret — needed for server-side tag operations
# (e.g. tagging "dlm-webinar-watched" when someone visits /workshop)
# Find this in Kit → Settings → Developer → API Secret
KIT_API_SECRET=

# ─────────────────────────────────────────
#  Circle (the school community)
# ─────────────────────────────────────────

# Optional — lets the /school "This month at school" card pull the next
# live call straight from the Circle events calendar.
# Create one in Circle → Settings → Developers → Tokens → type: Admin V2.
# Without it, the card uses the upcomingCalls list in content/school.ts.
CIRCLE_API_TOKEN=

# ─────────────────────────────────────────
#  Retreat application form (/retreats/lourinha)
# ─────────────────────────────────────────

# Resend — sends each application to the team. Required for the form.
# 1. Create a key at resend.com → API Keys
# 2. Verify seasonofself.co as a sending domain (add the DNS records Resend shows)
RESEND_API_KEY=

# Optional overrides (sensible defaults used if blank):
# APPLICATION_TO_EMAIL=hello@seasonofself.co
# APPLICATION_FROM_EMAIL=Season of Self <hello@seasonofself.co>

# Optional — also append each application to a Google Sheet.
# Deploy a Google Apps Script web app and paste its /exec URL here.
GOOGLE_SHEET_WEBHOOK_URL=

# ─────────────────────────────────────────
#  Blue — the subconscious-rewiring app (/blue)
# ─────────────────────────────────────────

# OpenAI — writes the scripts and narrates the voice. (Already added.)
OPENAI_API_KEY=

# Supabase — stores who to remind + journey progress (email-as-identity MVP).
# 1. Create a free project at supabase.com
# 2. Project Settings → Data API → copy the Project URL
# 3. Project Settings → API Keys → copy the **service_role** secret (NOT anon)
# 4. SQL Editor → paste supabase-schema.sql → Run
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# A random secret that protects the nightly reminder cron endpoint.
# Make up a long random string (e.g. from a password generator).
CRON_SECRET=

# The app's public base URL, used to build magic-link buttons in reminders.
# Local: http://localhost:3000   Production: https://your-domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# (Blue reuses the RESEND_API_KEY above to send the nightly nudge emails.)
